<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Reference implementation of the SpatialNET geometry interfaces including a geometry factory.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialNET.Core\SpatialNET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpatialNET.Tests" />
    <InternalsVisibleTo Include="SpatialNET.Playground" />
    <InternalsVisibleTo Include="SpatialNET.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
