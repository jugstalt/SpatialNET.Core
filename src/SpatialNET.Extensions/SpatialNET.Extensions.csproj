<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Planar spatial algorithms (overlay, buffer, cut, predicates …) as extension methods on the SpatialNET interfaces.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialNET.Core\SpatialNET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Teilflächen-Bildung wird von IO (Writer) mitgenutzt; die Tests prüfen interne Bausteine direkt. -->
    <InternalsVisibleTo Include="SpatialNET.IO" />
    <InternalsVisibleTo Include="SpatialNET.Tests" />
  </ItemGroup>

</Project>
