<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Planare räumliche Algorithmen (Overlay, Buffer, Cut, Prädikate …) als Extension-Methoden auf den SpatialNET-Interfaces.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialNET.Core\SpatialNET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Teilflächen-Bildung wird von IO (Writer) mitgenutzt; die Tests prüfen interne Bausteine direkt. -->
    <InternalsVisibleTo Include="SpatialNET.IO" />
    <InternalsVisibleTo Include="SpatialNET.Tests" />
  </ItemGroup>

</Project>
