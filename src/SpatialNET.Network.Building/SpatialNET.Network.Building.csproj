<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Neues Paket: Es gibt noch keine veröffentlichte Version zum Vergleich (ADR 0050). Nach dem ersten Release entfernen. -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <Description>Builds SpatialNET networks from the host's lines and points: joins line ends within a tolerance, splits lines at points and T junctions, assigns shards from polygons and streams nodes and edges to a writer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialNET.Core\SpatialNET.Core.csproj" />
    <ProjectReference Include="..\SpatialNET.Extensions\SpatialNET.Extensions.csproj" />
    <ProjectReference Include="..\SpatialNET.Network\SpatialNET.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpatialNET.Tests" />
    <InternalsVisibleTo Include="SpatialNET.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
