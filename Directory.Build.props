<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Vorab-Version; Versionierung und Release-Pipeline sind noch offen (Karte #1, Build/CI). -->
    <VersionPrefix>0.6.0</VersionPrefix>
  </PropertyGroup>

  <!-- Paket-Metadaten; packbar sind nur die Bibliotheken (IsPackable im jeweiligen Projekt). -->
  <PropertyGroup>
    <Authors>jugstalt</Authors>
    <Copyright>Copyright © Jürgen Gstaltmaier</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jugstalt/SpatialNET.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jugstalt/SpatialNET.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gis;geometry;spatial;clip;buffer;overlay</PackageTags>
  </PropertyGroup>

  <!-- NuGet-Vorbereitung: Debug-Symbole als .snupkg mit Source Link (im .NET SDK enthalten), reproduzierbare Builds in CI. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- API-Kompatibilitätsprüfung beim Packen (EnablePackageValidation in den Bibliotheksprojekten) gegen die zuletzt
       veröffentlichte Version. Nach jedem Release auf die neue Version setzen, siehe RELEASING.md. -->
  <PropertyGroup>
    <PackageValidationBaselineVersion>0.5.0-preview.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Öffentliche API (ADR 0028): PublicApiAnalyzers verlangt, dass jede öffentliche API in PublicAPI.Shipped.txt oder
       PublicAPI.Unshipped.txt steht (RS0016, RS0017). RS0026/RS0027 (mehrere Überladungen mit optionalen Parametern) sind
       abgeschaltet: Die typisierten Überladungen mit dem gemeinsamen Muster (factory = null, gridSize = null) sind Absicht (ADR 0012). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <!-- Die README liegt im Paket, sobald sie im Wurzelordner existiert. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Die Hinweise zu Drittanbietern und der Text der EDL 1.0 (JTS) liegen in jedem Paket: Die EDL verlangt bei Weitergabe in Binärform,
       Copyright-Vermerk und Haftungsausschluss beizulegen (THIRD-PARTY-NOTICES.md). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')">
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)samples\external\jts\LICENSE_EDLv1.txt" Pack="true" PackagePath="licenses\JTS-EDL-1.0.txt" Visible="false" />
  </ItemGroup>

</Project>
